# העתק את הקובץ הזה ל-.env ומלא את הערכים. הקובץ .env לא עולה ל-GitHub.

# --- Claude API (שלב 0) ---
# המפתח מ-console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# --- כללי ---
TIMEZONE=Asia/Jerusalem
# שעת תדריך הבוקר (כל יום)
MORNING_BRIEFING_TIME=07:15
# הקידומת שמפעילה את הבוט בצ'אט "הודעה לעצמי"
BOT_PREFIX=/בוט

# --- ווטסאפ (שלב 1/4) ---
# מזהי הקבוצות המורשות, מופרדים בפסיק. מקבלים אותם עם: npm run list-groups
WHATSAPP_GROUP_IDS=

# --- משו"ב (שלב 5) ---
MASHOV_SCHOOL_ID=
MASHOV_USERNAME=
MASHOV_PASSWORD=

# --- שחף (שלב 6) ---
SHAHAF_USERNAME=
SHAHAF_PASSWORD=
