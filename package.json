{
  "name": "self-agent",
  "version": "0.1.0",
  "private": true,
  "description": "סוכן אישי בווטסאפ: מערכת שעות, ציונים, אימונים, תזונה, קבוצות ויומן",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "check-claude": "tsx scripts/check-claude.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "list-groups": "tsx scripts/list-groups.ts",
    "set-key": "tsx scripts/set-key.ts",
    "set-mashov": "tsx scripts/set-mashov.ts",
    "google-auth": "tsx scripts/google-auth.ts",
    "update": "git checkout -- package-lock.json && git pull && npm ci"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@googleapis/calendar": "^20.2.0",
    "@libsql/client": "^0.18.0",
    "baileys": "^7.0.0-rc14",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.3.4",
    "pino": "^10.4.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/qrcode-terminal": "^0.12.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
